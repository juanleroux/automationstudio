<Window x:Class="TagCreator.SelectUDTsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select UDTs to Import" Height="400" Width="300" WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Select All Button -->
		<Button x:Name="SelectAllButton" Content="Select All" Width="80" HorizontalAlignment="Right" Click="SelectAllButton_Click" />

		<!-- List of UDTs -->
		<ScrollViewer Grid.Row="1" Margin="0,10,0,10">
			<ItemsControl x:Name="UDTsItemsControl">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- Buttons -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button Content="Cancel" Width="75" Margin="0,0,10,0" Click="CancelButton_Click"/>
			<Button Content="Import" Width="75" Click="ImportButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
