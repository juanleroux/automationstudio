    <!--Button style ************************************************************************************************** -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border 
                        Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="true">
                        <ContentPresenter 
                            Name="Presenter" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" Value="{StaticResource ButtonDisabledBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonDisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="#FFBEC3CD" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonMouseOverBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonMouseOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonPressedBrush}"/>
                        </Trigger>
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="true"/>
                                <Condition Property="IsEnabled" Value="true"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF3765BD"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--NavigationBarButtonStyle button style-->
    <Style TargetType="{x:Type Button}" x:Key="NavigationBarButtonStyle">
        <Setter Property="Background" Value="Transparent"/>        
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border 
                        Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="true">
                        <ContentPresenter 
                            Name="Presenter" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ContentPresenter.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle x:Name="IconRectangle" Fill="{TemplateBinding Foreground}" Width="24" Height="24" Margin="11,0"  HorizontalAlignment="Left" >
                                        <Rectangle.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Image RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock x:Name="TextBlock" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </ContentPresenter.Content>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="IconRectangle" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="TextBlock" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonMouseOverBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonMouseOverBrush}"/>
                            <Setter TargetName="IconRectangle" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter TargetName="IconRectangle" Property="Fill" Value="White"/>
                        </Trigger>
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="true"/>
                                <Condition Property="IsEnabled" Value="true"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF3765BD"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ThemeIconButtonStyle button style-->
    <Style TargetType="{x:Type Button}" x:Key="ThemeIconButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeMainBrush}"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border 
                        Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="true">
                        <ContentPresenter 
                            Name="Presenter" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ContentPresenter.Content>
                                <Rectangle x:Name="IconRectangle" Fill="{TemplateBinding Foreground}" Width="24" Height="24">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Image RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </ContentPresenter.Content>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="IconRectangle" Property="Fill" Value="{StaticResource ButtonDisabledContentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonMouseOverBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonMouseOverBrush}"/>
                            <Setter TargetName="IconRectangle" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter TargetName="IconRectangle" Property="Fill" Value="White"/>
                        </Trigger>
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="true"/>
                                <Condition Property="IsEnabled" Value="true"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF3765BD"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--GrayIconButtonStyle button style-->
    <Style TargetType="{x:Type Button}" x:Key="GrayIconButtonStyle" BasedOn="{StaticResource ThemeIconButtonStyle}">
        
        <Setter Property="Foreground" Value="Gray"/>
        
    </Style>

    <!--ThemeCircleButtonStyle button style-->
    <Style TargetType="{x:Type Button}" x:Key="ThemeCircleButtonStyle">
        <Setter Property="Background" Value="{StaticResource ThemeMainBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse 
                            Name="BackgroundEllipse" 
                            Fill="{TemplateBinding Background}" 
                            SnapsToDevicePixels="true"/>
                        <Rectangle x:Name="IconRectangle" Fill="{TemplateBinding Foreground}" Width="24" Height="24">
                            <Rectangle.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Image RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="IconRectangle" Property="Fill" Value="{StaticResource ButtonDisabledContentBrush}"/>
                            <Setter TargetName="BackgroundEllipse" Property="Fill" Value="{StaticResource ButtonDisabledBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundEllipse" Property="Fill" Value="{StaticResource ButtonMouseOverBrush}"/>
                            <Setter TargetName="IconRectangle" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundEllipse" Property="Fill" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter TargetName="IconRectangle" Property="Fill" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--GreyCircleButtonStyle button style-->
    <Style TargetType="{x:Type Button}" x:Key="GreyCircleButtonStyle" BasedOn="{StaticResource ThemeCircleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ButtonGreyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonGreyBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeMainBrush}"/>
    </Style>

    <!--Close button style-->
    <Style TargetType="{x:Type Button}" x:Key="CloseButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Rectangle x:Name="BackgroundRectangle" Fill="#FFE03A3A" Opacity="0"/>
                            <Path x:Name="IconPath" Data="M1,1 L11,11 M1,11 L11,1" Stroke="DarkGray" Margin="6,6,0,0" StrokeThickness="2"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundRectangle" Property="Opacity" Value="1"/>
                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFE6E6E6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Maximize button style-->
    <Style TargetType="{x:Type Button}" x:Key="MaximizeButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Rectangle x:Name="BackgroundRectangle" Fill="#FF168DE2" Opacity="0"/>
                            <Rectangle  x:Name="NormalIconRect" Width="12" Height="12" Stroke="DarkGray" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Visibility="Visible"/>
                            <Path x:Name="NormalIconPath" Data="M0,2 L12,2" Stroke="DarkGray" StrokeThickness="2" Margin="6,6,0,0" Visibility="Visible"/>
                            <Rectangle  x:Name="MaximizedIconRect" Width="9" Height="9" Stroke="DarkGray"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,9,0,0" Visibility="Hidden"/>
                            <Path x:Name="MaximizedIconPath1" Data="M0,4 L9,4" Stroke="DarkGray" StrokeThickness="2" Margin="6,6,0,0" Visibility="Hidden"/>
                            <Path x:Name="MaximizedIconPath2" Data="M3.5,3 L3.5,0 M3,0.5 L12,0.5 M11.5,0 L11.5,9 M12,8.5 L9,8.5" Stroke="DarkGray" StrokeThickness="1" Margin="6,6,0,0" Visibility="Hidden"/>
                            <Path x:Name="MaximizedIconPath3" Data="M3,1 L12,1" Stroke="DarkGray" StrokeThickness="2" Margin="6,6,0,0" Visibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundRectangle" Property="Opacity" Value="1"/>
                            <Setter TargetName="NormalIconRect" Property="Stroke" Value="LightGray"/>
                            <Setter TargetName="NormalIconPath" Property="Stroke" Value="LightGray"/>
                            <Setter TargetName="MaximizedIconRect" Property="Stroke" Value="LightGray"/>
                            <Setter TargetName="MaximizedIconPath1" Property="Stroke" Value="LightGray"/>
                            <Setter TargetName="MaximizedIconPath2" Property="Stroke" Value="LightGray"/>
                            <Setter TargetName="MaximizedIconPath3" Property="Stroke" Value="LightGray"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"  Value="Maximized">
                            <Setter TargetName="NormalIconRect" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="NormalIconPath" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="MaximizedIconRect" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MaximizedIconPath1" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MaximizedIconPath2" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MaximizedIconPath3" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="NoResize">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Minimize button style-->
    <Style TargetType="{x:Type Button}" x:Key="MinimizeButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Rectangle x:Name="BackgroundRectangle" Fill="#FF168DE2" Opacity="0"/>
                            <Path x:Name="IconPath" Data="M1,11 L11,11" Stroke="DarkGray" StrokeThickness="2" Margin="6,6,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundRectangle" Property="Opacity" Value="1" />
                            <Setter TargetName="IconPath" Property="Stroke" Value="LightGray"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="NoResize">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "TabControl" ToggleButton style -->
    <Style TargetType="{x:Type ToggleButton}" x:Key="TabControlToggleButtonStyle">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="#FF7D8287"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border 
                        Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"                                                
                        SnapsToDevicePixels="true">
                        <ContentPresenter 
                            Name="Presenter" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonMouseOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox style -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Border 
                        Name="Border" 
                        CornerRadius="0" 
                        Padding="2" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="WhiteSmoke" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ReadOnly" />
                                <VisualState x:Name="MouseOver" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ScrollViewer Margin="0"
                        x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="DarkGray"/>
                            <Setter Property="Background" Value="{StaticResource TextBoxReadonlyBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="{StaticResource TextBoxReadonlyBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#FF3765BD"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- NumericTextBox style -->
    <Style TargetType="{x:Type mc:NumericTextBox}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <Border 
                        Name="Border" 
                        CornerRadius="0" 
                        Padding="2" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="WhiteSmoke" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ReadOnly" />
                                <VisualState x:Name="MouseOver" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ScrollViewer Margin="0"
                        x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="DarkGray"/>
                            <Setter Property="Background" Value="{StaticResource TextBoxReadonlyBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="{StaticResource TextBoxReadonlyBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
