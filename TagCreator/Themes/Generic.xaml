<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:TagCreator"   
    xmlns:mc="clr-namespace:MyControls"   
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    >

    <!--Data converters *******************************************************************************************************-->
    <a:BoolInvertConverter x:Key="BoolInvertConverter"/>
    <a:DataTypeConverter x:Key="DataTypeConverter"/>
    <a:TreeViewConverter x:Key="TreeViewConverter"/>

