    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FFAFAFAF"/>
    <SolidColorBrush x:Key="WindowTitleBarBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DataPanelBackgroundBrush" Color="#FFBEBEBE"/>
    <SolidColorBrush x:Key="DataPanelGroupBackgroundBrush" Color="#FFAAAFB4"/>
    <SolidColorBrush x:Key="DataPanelTitleBrush" Color="#FF646464"/>
    <SolidColorBrush x:Key="DataNameBackgroundBrush_1" Color="#FFF0F078"/>
    <SolidColorBrush x:Key="DataValueBackgroundBrush_1" Color="#FFDCDCDC"/>
    <SolidColorBrush x:Key="DataNameBackgroundBrush_2" Color="#FFFFFF9B"/>
    <SolidColorBrush x:Key="DataValueBackgroundBrush_2" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="DataValueForegroundBlueBrush" Color="#FF002850"/>
    <SolidColorBrush x:Key="DataValueForegroundGreenBrush" Color="#FF006400"/>
    <SolidColorBrush x:Key="DataValueForegroundRedBrush" Color="#FFC80000"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF2E7EB8"/>
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ButtonDisabledContentBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="ButtonMouseOverBrush" Color="#FF168DE2"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF1482D1"/>
    <SolidColorBrush x:Key="ButtonGreyBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="TextBoxReadonlyBackgroundBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="DarkComboBoxBackgroundBrush" Color="#FF787D87" />
    <SolidColorBrush x:Key="DarkComboBoxBorderBrush" Color="#FF787D87" />
    <SolidColorBrush x:Key="ComboBoxDisabledForegroundBrush" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="DarkComboBoxDisabledForegroundBrush" Color="#FFBEC3CD" />
    <SolidColorBrush x:Key="ComboBoxDisabledBackgroundBrush" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="DarkComboBoxDisabledBackgroundBrush" Color="#FFA0A5AF" />
    <SolidColorBrush x:Key="ComboBoxDisabledBorderBrush" Color="#FFA0A5AF" />
    <SolidColorBrush x:Key="ThemeMainBrush" Color="#FF21AEFF" />    

    <!--Font size *******************************************************************************************************-->
    <!--Designer oversizes fonts, runtime size is bigger, look at: MainWindow::Window_SizeChanged-->
    <sys:Double x:Key="FontSize_Button">10.0</sys:Double>
    <!--Runtime size: 14-->
    <sys:Double x:Key="FontSize_GroupHeader">12.0</sys:Double>
    <!--Runtime size: 18-->
    <sys:Double x:Key="FontSize_NormalText">10.0</sys:Double>
    <!--Runtime size: 16-->
    <sys:Double x:Key="FontSize_DataName_1">11.0</sys:Double>
    <!--Runtime size: 17-->
    <sys:Double x:Key="FontSize_DataName_2">8.0</sys:Double>
    <!--Runtime size: 11-->
    <sys:Double x:Key="FontSize_DataName_3">10.0</sys:Double>
    <!--Runtime size: 14-->
    <sys:Double x:Key="FontSize_DataName_4">8.0</sys:Double>
    <!--Runtime size: 12-->
    <sys:Double x:Key="FontSize_DataValue_1">32.0</sys:Double>
    <!--Runtime size: 42-->
    <sys:Double x:Key="FontSize_DataValue_2">16.0</sys:Double>
    <!--Runtime size: 26-->
