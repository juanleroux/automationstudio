<mc:WindowBase  
    x:Class="TagCreator.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:TagCreator"
    xmlns:mc="clr-namespace:MyControls"
    Style="{StaticResource {x:Type Window}}" 
    Title="Settings" Height="600" Width="1000" WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="/Images/Application.png" MinWidth="700" MinHeight="470" PreviewMouseDown="Window_PreviewMouseDown" ShowInTaskbar="False">
    <Grid>
        <!--Workspace-->
		<TabControl x:Name="_tabControl" SelectedIndex="0" Margin="50,0,0,0" PreviewMouseRightButtonDown="_tabControl_PreviewMouseRightButtonDown" BorderThickness="0" Background="White" >
			<TabControl.Resources>
				<Style TargetType="TabItem">
					<Setter Property="Visibility" Value="Collapsed"/>
				</Style>
			</TabControl.Resources>

			<TabItem>
				<a:APISettingsControl x:Name="_apiSettingsControl" Margin="-4,-4,-4,-4" />
			</TabItem>

			<TabItem>
				<a:EngineeringSettingsControl x:Name="_engineeringSettingsControl" Margin="-4,-4,-4,-4" />
			</TabItem>
		</TabControl>
        <!--Navigation Pane-->
        <Grid x:Name="_navigationGrid" Background="{StaticResource ThemeMainBrush}" HorizontalAlignment="Left" >
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Width" Value="50"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNavigationPanelExpanded}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="50"  To="250" Duration="0:00:00.025"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="250" To="50" Duration="0:00:00.250"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel >
				<Button Style="{StaticResource NavigationBarButtonStyle}" Content="/Images/Menu.png" Click="NavigationPanelVisibilityButton_Click"/>
				<Button Style="{StaticResource NavigationBarButtonStyle}" Content="/Images/API.png" Tag="API settings" Click="APISettingsMenuItem_Click" />
				<Button Style="{StaticResource NavigationBarButtonStyle}" Content="/Images/Database.png" Tag="Engineering settings" Click="EngineeringSettingsMenuItem_Click" />
			</StackPanel>            
        </Grid>
    </Grid>
</mc:WindowBase>
