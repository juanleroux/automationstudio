        private void _treeView_PreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)
        {
            //set long press renamed item
            _renameTreeViewItem = GetNearestTreeViewItem(e.OriginalSource as UIElement);
            if (_renameTreeViewItem == null)
                return;

            _treeViewTimer.Start();
            _dragDropStartPosition = e.GetPosition(null);

			// MULTI SELECT
			try
			{
				DependencyObject obj = (DependencyObject)e.OriginalSource;
				while (obj != null && !(obj is TreeViewItem))
					obj = VisualTreeHelper.GetParent(obj);

				if (obj == null)
					return;

				TreeViewItem clickedItem = obj as TreeViewItem;
				clickedItem.Focus();

				var item = clickedItem.DataContext;

				bool isCtrl = Keyboard.IsKeyDown(Key.LeftCtrl) || Keyboard.IsKeyDown(Key.RightCtrl);
				bool isShift = Keyboard.IsKeyDown(Key.LeftShift) || Keyboard.IsKeyDown(Key.RightShift);

				// ------------------ INSTANCE ------------------
				if (item is Instance instance)
				{
					_lastSelectedTemplate = null;

					if (isCtrl)
					{
						instance.IsSelected = !instance.IsSelected;

						if (instance.IsSelected)
							_selectedInstances.Add(instance);
						else
							_selectedInstances.Remove(instance);

						_lastSelectedInstance = instance;

						foreach (var t in _project.Templates.Items)
							t.IsSelected = false;

						e.Handled = true;
					}
					else if (isShift && _lastSelectedInstance != null)
					{
						var allInstances = GetAllInstances();

						int start = allInstances.IndexOf(_lastSelectedInstance);
						int end = allInstances.IndexOf(instance);

						if (start > end)
						{
							int temp = start;
							start = end;
							end = temp;
						}

						foreach (var inst in allInstances.Skip(start).Take(end - start + 1))
						{
							inst.IsSelected = true;
							if (!_selectedInstances.Contains(inst))
								_selectedInstances.Add(inst);
						}
					}
					else
					{
						ClearAllSelections();

						instance.IsSelected = true;
						_selectedInstances.Add(instance);
						_lastSelectedInstance = instance;
					}
				}

				// ------------------ TEMPLATE ------------------
				else if (item is Template template)
				{
					_lastSelectedTemplate = template;
					_lastSelectedInstance = null;

					// Clear ALL selections (instances + templates)
					ClearAllSelections();

					foreach (var t in _project.Templates.Items)
						t.IsSelected = false;

					template.IsSelected = true;
				}
			}
			catch (Exception ex)
			{
				gLog.Error(ex.ToString());
			}
		}

		private void ClearAllSelections()
		{
			foreach (var inst in _selectedInstances)
				inst.IsSelected = false;

			_selectedInstances.Clear();

			foreach (var t in _project.Templates.Items)
				t.IsSelected = false;
		}

		private List<Instance> GetAllInstances()
		{
			return _project.Templates.Items
				.SelectMany(t => t.Instances.Items)
				.ToList();
		}


		private void _treeView_PreviewMouseMove(object sender, MouseEventArgs e)
        {
            try
            {
                Vector difference = _dragDropStartPosition - e.GetPosition(null);

                if (e.LeftButton == MouseButtonState.Released)
                    return;

                if (Math.Abs(difference.X) < SystemParameters.MinimumHorizontalDragDistance && Math.Abs(difference.Y) < SystemParameters.MinimumVerticalDragDistance)
                    return;

                if (IsMouseOverScrollbar(sender, e.GetPosition(sender as IInputElement)))
                    return;

                //disable renaming timer if item changed
                TreeViewItem item = GetNearestTreeViewItem(e.OriginalSource as UIElement);
                if (item == null || item != _renameTreeViewItem)
                    _treeViewTimer.Stop();

                //Initialize drag & drop object
                if (_isInstanceSelected)
                {
                    _treeViewTimer.Stop();

                    DataObject dragData = new DataObject("Instance", _currentInstance);
                    DragDrop.DoDragDrop(_treeView, dragData, DragDropEffects.Move);
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

