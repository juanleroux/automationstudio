        private void _treeView_Drop(object sender, DragEventArgs e)
        {
            try
            {
                //get TreeViewItem object
                TreeViewItem item = GetNearestTreeViewItem(e.OriginalSource as UIElement);
                if (item == null)
                    return;

                if (e.Data.GetDataPresent("Instance"))
                {
                    //get target template
                    Template template = null;
                    if (item.DataContext.GetType() == typeof(Template))
                        template = (Template)item.DataContext;

                    if (item.DataContext.GetType() == typeof(Instance))
                        template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)item.DataContext) > 0).SingleOrDefault();

                    //get dragged object
                    Instance movedInstance = e.Data.GetData("Instance") as Instance;
                    Template movedInstanceTemplate = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == movedInstance) > 0).SingleOrDefault();

                    if (template == movedInstanceTemplate)
                        return;

                    var instance = new Instance() { Name = movedInstance.Name, Description = movedInstance.Description, IsFlagged = movedInstance.IsFlagged, AreaId = movedInstance.AreaId };
                    template.AddInstance(instance);

                    //add template's attributes, copy value from dragged instance
                    foreach (AttributeBase attribute in template.Attributes.Items)
                    {
                        InstanceAttribute movedAttribute = movedInstance.Attributes.Items.Where(u => u.Name.Equals(attribute.Name, StringComparison.OrdinalIgnoreCase) && u.DataType == attribute.DataType).FirstOrDefault();

                        if (movedAttribute != null)
                            instance.AddAttribute(new InstanceAttribute() { Id = attribute.Id, Value = movedAttribute.Value });
                        else
                            instance.AddAttribute(new InstanceAttribute() { Id = attribute.Id });
                    }
                    
                    //remove old instance
                    Area movedArea = _project.Areas.Items.Where(u => u.Id == movedInstance.AreaId).Single();
                    movedArea.RemoveInstance(movedInstance);
                    movedInstanceTemplate.RemoveInstance(movedInstance);

                    //reorder old instance id's
                    foreach (Instance oldInstance in movedInstanceTemplate.Instances.Items)
                    {
                        if (oldInstance.Id > movedInstance.Id)
                            oldInstance.Id--;
                    }

                    //add to area
                    movedArea.AddInstance(instance);

                    //select treeView item 
                    template.IsExpanded = true;
                    instance.IsSelected = true;

                    _treeView.UpdateLayout();
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }        

