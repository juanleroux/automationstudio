        private void _treeView_SelectedItemChanged(object sender, RoutedPropertyChangedEventArgs<object> e)
        {
			var api = new IgnitionAPI();
            var selectedItem = _treeView.SelectedItem;

            try
            {
                RemoveProfileTabPages();

				// Remove previous dynamic Import UDTs menu items
				foreach (var item in _treeViewImportMenuItem.Items
						 .OfType<MenuItem>()
						 .Where(m => (string)m.Header == "Import UDTs from Ignition")
						 .ToList())
				{
					_treeViewImportMenuItem.Items.Remove(item);
				}

				if (Project.Engineering.EnableIgnitionMenuItems)
				{
					// Create Import UDTs from Ignition menu item.
					MenuItem importUDTs = new MenuItem()
					{
						Header = "Import UDTs from Ignition",
					};

					// Add functionality when ignition menu item is clicked. Pass selected item, project, sender and event args to the API function.
					importUDTs.Click += async (s, ee) =>
					{
						await api.ImportUDTs(_project);
					};

					// Adds Import UDTs from Ignition menu item to the import profile menu.
					if (!_treeViewImportMenuItem.Items
						.OfType<MenuItem>()
						.Any(m => (string)m.Header == "Import UDTs from Ignition"))
					{
						_treeViewImportMenuItem.Items.Add(importUDTs);
					}
				}

				if (selectedItem == null)
                {
                    _templateAttributesControl.DataGridItemsSource = null;
                    TemplateName = string.Empty;

                    return;
                }

                //get selected template, set datagrid source
                if (selectedItem.GetType() == typeof(Template))
                {                    
                    _currentTemplate = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single();
                    _currentInstance = null;
                    TemplateName = _currentTemplate.Name;

                    _tabControl.SelectedIndex = 0;
                    _templateAttributesControl.DataGridItemsSource = _currentTemplate.Attributes.Items;
                }

                //get instance and it's parent template, set datagrid source
                if (selectedItem.GetType() == typeof(Instance))
                {
                    _currentTemplate = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).SingleOrDefault();
                    _currentInstance = _currentTemplate.Instances.Items.Where(u => u == (Instance)selectedItem).Single();
                    Area area = _project.Areas.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).SingleOrDefault();                
                    TemplateName = String.Format(@"\\{0}\{1}", area.Name, _currentInstance.Name);

                    //copy properties from template to instance (name, desc, data type)
                    foreach (AttributeBase attribute in _currentTemplate.Attributes.Items)
                        _currentInstance.Attributes.Items.Where(u => u.Id == attribute.Id).Single().GetParentsProperties(attribute);

                    _tabControl.SelectedIndex = 0;
                    _templateAttributesControl.DataGridItemsSource = _currentInstance.Attributes.Items;
                }

                _templateAttributesControl.ApplyDataGridSorting();
                _templateAttributesControl.MakeDataGridSelection();

                //remove previous profile export menu items
                if (_treeViewExportProfileMenuItem.Items.Count > 2)
                {
                    int count = _treeViewExportProfileMenuItem.Items.Count;
                    for (int i = 2; i < count; i++)
                        _treeViewExportProfileMenuItem.Items.RemoveAt(2);
                }

				// Only add separator if there will be any dynamic items below it
				bool shouldAddSeparator = _project.Engineering.EnableIgnitionMenuItems && (_currentTemplate.Profiles.Items.Count > 0 || _currentInstance != null || _currentTemplate != null);

				if (shouldAddSeparator)
					_treeViewExportProfileMenuItem.Items.Add(new Separator());

				//get profiles
				foreach (Profile profile in _currentTemplate.Profiles.Items)
					AddProfileTabPage(profile);

				if (_project.Engineering.EnableIgnitionMenuItems && selectedItem.GetType() == typeof(Instance))
				{
					// Create Upload to Ignition menu item.
					MenuItem uploadToIgnition = new MenuItem()
					{
						Header = "Upload to Ignition",
					};

					// Add functionality when ignition menu item is clicked. Pass selected item, project, sender and event args to the API function.
					uploadToIgnition.Click += (s, ee) =>
					{
						if (!_selectedInstances.Any())
						{
							MessageBox.Show("No instances selected.");
							return;
						}

						if (!ConfirmIgnitionOverwrite())
							return;

						foreach (var instance in _selectedInstances)
						{
							api.UploadTag_Click(instance, _project, s, e);
						}

                        MessageBox.Show("Upload Complete.");
					};

					// Adds Upload to Ignition menu item to the export profile menu.
					_treeViewExportProfileMenuItem.Items.Add(uploadToIgnition);
				}
                else if(_project.Engineering.EnableIgnitionMenuItems && selectedItem.GetType() == typeof(Template))
                {
					// Create Upload to Ignition menu item.
					MenuItem uploadChildrenToIgnition = new MenuItem()
					{
						Header = "Upload children to Ignition",
					};

                    // Add functionality when ignition menu item is clicked. Pass selected item, project, sender and event args to the API function.
                    uploadChildrenToIgnition.Click += (s, ee) =>
                    {
                        var instancesToExport = _lastSelectedTemplate.Instances.Items.ToList();
                        if (!instancesToExport.Any())
                        {
                            MessageBox.Show("No instances to export.", "Export", MessageBoxButton.OK, MessageBoxImage.Information);
                            return;
                        }

                        if (!ConfirmIgnitionOverwrite())
                            return;

                        foreach (var instance in instancesToExport)
                        {
                            api.UploadTag_Click(instance, _project, s, e); // your existing method
                        }

                        MessageBox.Show($"{instancesToExport.Count} instance(s) exported successfully.", "Export Complete", MessageBoxButton.OK, MessageBoxImage.Information);
                    };

					// Adds Upload to Ignition menu item to the export profile menu.
					_treeViewExportProfileMenuItem.Items.Add(uploadChildrenToIgnition);
				}


			}
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
            finally
            {
                IsTemplateSelected = selectedItem != null && selectedItem.GetType() == typeof(Template);
                IsInstanceSelected = selectedItem != null && selectedItem.GetType() == typeof(Instance);                
                IsTreeViewEditMode = false;                
            }
        }

        private void DeleteMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;

            try
            {
                if (selectedItem == null)
                    return;

                //get selected template
                if (selectedItem.GetType() == typeof(Template))
                {
                    var item = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single();

                    if (MainWindow.Confirm("Are you sure that you want to delete template {0}?", item.Name) == true)
                        _project.Templates.Items.Remove(item);

                    return;
                }

                //get selected instance
                if (selectedItem.GetType() == typeof(Instance))
                {
                    var template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                    var instance = template.Instances.Items.Where(u => u == (Instance)selectedItem).Single();

                    if (MainWindow.Confirm("Are you sure that you want to delete instance {0}?", instance.Name) == true)
                    {
                        template.RemoveInstance(instance);
                        _project.Areas.Items.Where(u => u.Id == instance.AreaId).Single().RemoveInstance(instance);
                    }

                    return;
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

