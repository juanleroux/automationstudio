		private void AddInstanceMenuItem_Click(object sender, RoutedEventArgs e)
		{
			if (_currentTemplate == null) return;

			// Create new instance
			var instance = new Instance()
			{
				Name = "New Instance",
				Description = "<No Description>"
			};
			_currentTemplate.AddInstance(instance);

			// Add to unassigned area
			var defaultArea = _project.Areas.Items.SingleOrDefault(u => u.Id == 0);
			if (defaultArea != null)
				defaultArea.AddInstance(instance);

			// Add template's attributes to instance
			foreach (AttributeBase attribute in _currentTemplate.Attributes.Items)
				instance.AddAttribute(new InstanceAttribute()
				{
					Id = attribute.Id,
					Name = attribute.Name,
					DataType = attribute.DataType,
					Value = null // or default
				});

			// Expand template in tree and select new instance
			_currentTemplate.IsExpanded = true;

			_treeView.UpdateLayout();

			// Wait for UI to generate TreeViewItem
			Dispatcher.BeginInvoke(new Action(() =>
            {
                // Find the TreeViewItem for the new instance
                TreeViewItem tvi = FindTreeViewItem(_treeView, instance);
                if (tvi != null)
                {
                    tvi.Focus();
                    tvi.IsSelected = true;
                    IsTreeViewEditMode = true;  // enter rename mode
                }
            }), System.Windows.Threading.DispatcherPriority.Background);
		}

		private TreeViewItem FindTreeViewItem(ItemsControl container, object item)
		{
			if (container == null) return null;

			for (int i = 0; i < container.Items.Count; i++)
			{
				TreeViewItem tvi = container.ItemContainerGenerator.ContainerFromIndex(i) as TreeViewItem;
				if (tvi == null) continue;

				if (tvi.DataContext == item) return tvi;

				// recursively check child items
				TreeViewItem child = FindTreeViewItem(tvi, item);
				if (child != null) return child;
			}
			return null;
		}

		private void DuplicateMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;

            try
            {
                if (selectedItem == null)
                    return;

                //get selected template
                if (selectedItem.GetType() == typeof(Template))
                {
                    var template = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single();
                    var newTemplate = new Template(template as Template);

                    //find number at end of name
                    Match m = Regex.Match(template.Name, @"\d+$");
                    if (m.Success)
                    {
                        int num = Convert.ToInt32(m.Value);

                        //increment number, search for unique name in template's list
                        do
                        {
                            //add leading zeroes
                            string sNum = (++num).ToString();
                            while (m.Value.Length > sNum.Length)
                                sNum = sNum.Insert(0, "0");

                            newTemplate.Name = string.Format("{0}{1}", template.Name.Substring(0, template.Name.Length - m.Value.Length), sNum);
                        }
                        while (_project.Templates.Items.Count(u => u.Name.Equals(newTemplate.Name, StringComparison.OrdinalIgnoreCase)) > 0);
                    }

                    _project.Templates.AddTemplate(newTemplate);

                    //select treeView item and put in edit mode
                    newTemplate.IsSelected = true;
                    IsTreeViewEditMode = true;
                }

                //get selected instance
                if (selectedItem.GetType() == typeof(Instance))
                {
                    var template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                    var instance = template.Instances.Items.Where(u => u == (Instance)selectedItem).Single();
                    var newInstance = new Instance(instance as Instance);

                    //find number at end of name
                    Match m = Regex.Match(instance.Name, @"\d+$");
                    if (m.Success)
                    {
                        int num = Convert.ToInt32(m.Value);

                        //increment number, search for unique name in instances list
                        do
                        {
                            //add leading zeroes
                            string sNum = (++num).ToString();
                            while (m.Value.Length > sNum.Length)
                                sNum = sNum.Insert(0, "0");

                            newInstance.Name = string.Format("{0}{1}", instance.Name.Substring(0, instance.Name.Length - m.Value.Length), sNum);
                        }
                        while (template.Instances.Items.Count(u => u.Name.Equals(newInstance.Name, StringComparison.OrdinalIgnoreCase)) > 0);
                    }

                    //add to template
                    template.AddInstance(newInstance);

                    //add to area
                    _project.Areas.Items.Where(u => u.Id == newInstance.AreaId).Single().AddInstance(newInstance);

                    //select treeView item and put in edit mode
                    template.IsExpanded = true;
                    newInstance.IsSelected = true;

                    _treeView.UpdateLayout();
                    IsTreeViewEditMode = true;
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private void ImportMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;

            try
            {
                Template template = null;
                if (selectedItem != null)
                {
                    //get selected template
                    if (selectedItem.GetType() == typeof(Template))
                        template = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single() as Template;

                    //get template from selected instance
                    if (selectedItem.GetType() == typeof(Instance))
                        template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                }

                Microsoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();

                //if not selected, allow only templates import (txt files)
                if (template == null)
                    openFileDialog.Filter = "Text Files (*.txt)|*.txt";
                else
                    openFileDialog.Filter = "CSV Files (*.csv)|*.csv|Text Files (*.txt)|*.txt";

                if (openFileDialog.ShowDialog(MainWindow) != true)
                    return;

                using (StreamReader reader = new StreamReader(openFileDialog.FileName))
                {
                    string line = reader.ReadLine();

                    if (line.Equals("Type: Instance", StringComparison.OrdinalIgnoreCase))
                        ImportInstance(reader, template);

                    if (line.Equals("Type: Template", StringComparison.OrdinalIgnoreCase))
                        ImportTemplate(reader);

                    reader.Close();
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private void ExportTemplateMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;

            try
            {
                if (selectedItem == null)
                    return;

                Template template = null;

                //get selected template
                if (selectedItem.GetType() == typeof(Template))
                    template = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single() as Template;

                //get template from selected instance
                if (selectedItem.GetType() == typeof(Instance))
                    template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();

                Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog();
                saveFileDialog.Filter = "Text Files (*.txt)|*.txt";

                //saveFileDialog.FileName = "test.csv";
                if (saveFileDialog.ShowDialog(MainWindow) != true)
                    return;

                using (StreamWriter writer = new StreamWriter(saveFileDialog.FileName))
                {
                    StringBuilder line = new StringBuilder();

                    //write type
                    writer.WriteLine("Type: Template");

                    //write name
                    writer.WriteLine(string.Format("Name: {0}", template.Name));
                    //write description
                    writer.WriteLine(string.Format("Description: {0}", template.Description));

                    //write header
                    writer.WriteLine("Name,Description,Datatype,Value");

                    //write rows
                    foreach (TemplateAttribute attribute in template.Attributes.Items.OrderBy(u => u.Id))
                    {
                        line.Clear();
                        line.Append(attribute.Name).Append(",");
                        line.Append(attribute.Description).Append(",");
                        line.Append(DataTypes.Where(u => u.Id == attribute.DataType).Single().Name).Append(",");
                        line.Append(attribute.Value);

                        writer.WriteLine(line);
                    }

                    //add Profiles
                    foreach (Profile profile in template.Profiles.Items)
                    {
                        //write type
                        writer.WriteLine("Type: Profile");
                        //write name
                        writer.WriteLine(string.Format("Name: {0}", string.IsNullOrEmpty(profile.Name) ? "NULL" : profile.Name));
                        //write description
                        writer.WriteLine(string.Format("Description: {0}", string.IsNullOrEmpty(profile.Description) ? "NULL" : profile.Description));
                        //write export settings
                        writer.WriteLine(string.Format("Export: {0},{1},{2},{3}", profile.ExportType, profile.FormatType, string.IsNullOrEmpty(profile.CustomFormat) ? "NULL" : profile.CustomFormat, string.IsNullOrEmpty(profile.TabularExportDelimiter) ? "NULL" : profile.TabularExportDelimiter));
                        //write StructuralExportTemplate
                        writer.WriteLine("BEGIN STRUCTURAL EXPORT TEMPLATE");
                        writer.WriteLine(profile.StructuralExportTemplate);
                        writer.WriteLine("END STRUCTURAL EXPORT TEMPLATE");
                        //write header
                        writer.WriteLine("Name,Description,Datatype,Rule");

                        //write rows
                        foreach (ProfileAttribute attribute in profile.Attributes.Items)
                        {
                            line.Clear();
                            line.Append(string.IsNullOrEmpty(attribute.Name) ? "NULL" : attribute.Name).Append(",");
                            line.Append(string.IsNullOrEmpty(attribute.Description) ? "NULL" : attribute.Description).Append(",");
                            line.Append(DataTypes.Where(u => u.Id == attribute.DataType).Single().Name).Append(",");
                            line.Append(attribute.Rule);

                            writer.WriteLine(line);
                        }
                    }

                    writer.Close();
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private void ExportInstanceMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;            

            try
            {
                if (selectedItem == null)
                    return;

                Template template = null;
                Instance selectedInstance = null;

                //get selected template
                if (selectedItem.GetType() == typeof(Template))
                    template = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single() as Template;

                //get template from selected instance
                if (selectedItem.GetType() == typeof(Instance))
                {
                    template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                    selectedInstance = template.Instances.Items.Where(u => u == (Instance)selectedItem).Single();
                }

                Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog();
                saveFileDialog.Filter = "CSV Files (*.csv)|*.csv";

                //saveFileDialog.FileName = "test.csv";
                if (saveFileDialog.ShowDialog(MainWindow) != true)
                    return;

                using (StreamWriter writer = new StreamWriter(saveFileDialog.FileName))
                {
                    StringBuilder line = new StringBuilder();

                    //write type
                    writer.WriteLine("Type: Instance");

                    //write header
                    line.Append("Name,Description,");
                    foreach (TemplateAttribute attribute in template.Attributes.Items.OrderBy(u => u.Id))
                        line.Append(attribute.Name).Append(",");

                    writer.WriteLine(line);

                    //write rows
                    foreach (Instance instance in (selectedInstance != null) ? template.Instances.Items.Where(u => u == selectedInstance) : template.Instances.Items)
                    {
                        line.Clear();
                        line.Append(string.IsNullOrEmpty(instance.Name) ? "NULL" : instance.Name).Append(",");
                        line.Append(string.IsNullOrEmpty(instance.Description) ? "NULL" : instance.Description).Append(",");

                        foreach (InstanceAttribute attribute in instance.Attributes.Items.OrderBy(u => u.Id))
                            line.Append(attribute.Value).Append(",");

                        writer.WriteLine(line);
                    }

                    writer.Close();
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }        

