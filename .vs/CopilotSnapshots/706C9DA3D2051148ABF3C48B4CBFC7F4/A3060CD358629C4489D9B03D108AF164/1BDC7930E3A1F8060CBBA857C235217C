        public void ExportProfile(Profile profile)
        {
            try
            {
                var selectedItem = _treeView.SelectedItem;
                if (selectedItem == null)
                    return;

                // detect if multiple instances are selected
                List<Instance> multiInstances = (_selectedInstances != null && _selectedInstances.Count > 1) ? _selectedInstances.ToList() : null;

                Instance selectedInstance = null;
                if (selectedItem.GetType() == typeof(Instance))
                {
                    var template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                    selectedInstance = template.Instances.Items.Where(u => u == (Instance)selectedItem).Single();
                }

                //create file dialog extension filter 
                StringBuilder filter = new StringBuilder();
                foreach (ProfileFormatType format in new ProfileFormatTypes())
                    filter.Append(format.FileDialogFilter).Append("|");

                filter.Replace("*.xxx", string.IsNullOrEmpty(profile.CustomFormat) ? "*.*" : string.Format("*.{0}", profile.CustomFormat));

                Microsoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog();
                saveFileDialog.Filter = filter.ToString().TrimEnd(new char[] { '|' });
                saveFileDialog.FilterIndex = profile.FormatType + 1;

                //saveFileDialog.FileName = "test.csv";
                if (saveFileDialog.ShowDialog(MainWindow) != true)
                    return;

                var tabItem = _tabControl.Items.Cast<TabItem>().Where(u => u.Content != null && u.Content.GetType() == typeof(ProfileAttributesControl)).FirstOrDefault();
                if (tabItem == null)
                    return;

                var pac = (ProfileAttributesControl)tabItem.Content;

                // If multiple instances selected, allow merging across templates as long as each template contains a compatible profile
                if (multiInstances != null && multiInstances.Any())
                {
                    // Group selected instances by their parent template
                    var groups = multiInstances.GroupBy(inst => _project.Templates.Items.Where(t => t.Instances.Items.Contains(inst)).Single());

                    // Verify each template has a compatible profile (by name and export settings)
                    foreach (var g in groups)
                    {
                        var tmpl = g.Key;
                        bool has = tmpl.Profiles.Items.Any(p => p.Name == profile.Name && p.ExportType == profile.ExportType && p.FormatType == profile.FormatType && p.CustomFormat == profile.CustomFormat && p.TabularExportDelimiter == profile.TabularExportDelimiter);
                        if (!has)
                        {
                            MessageBox.Show("All selected instances must have a compatible profile to merge exports.");
                            return;
                        }
                    }

                    // remember original current template to restore later
                    var originalTemplate = _currentTemplate;

                    try
                    {
                        // For tabular exports: export per-template groups to temp files and merge headers
                        if (profile.ExportType == ProfileExportTypes.Tabular)
                        {
                            List<string> tempFiles = new List<string>();
                            try
                            {
                                foreach (var g in groups)
                                {
                                    var tmpl = g.Key;
                                    // set current template for exporter
                                    _currentTemplate = tmpl;

                                    // find matching profile instance on this template
                                    var localProfile = tmpl.Profiles.Items.Where(p => p.Name == profile.Name && p.ExportType == profile.ExportType && p.FormatType == profile.FormatType && p.CustomFormat == profile.CustomFormat && p.TabularExportDelimiter == profile.TabularExportDelimiter).SingleOrDefault();
                                    if (localProfile == null)
                                    {
                                        MessageBox.Show("Profile not found on template " + tmpl.Name);
                                        return;
                                    }

                                    string temp = System.IO.Path.GetTempFileName();
                                    pac.ExportTabularProfile(localProfile, g.ToList(), temp);
                                    tempFiles.Add(temp);
                                }

                                // combine temp files: write first file entirely, then append others skipping their header line
                                using (var outStream = new System.IO.StreamWriter(saveFileDialog.FileName, false))
                                {
                                    bool first = true;
                                    foreach (var tf in tempFiles)
                                    {
                                        var lines = System.IO.File.ReadAllLines(tf);
                                        if (first)
                                        {
                                            foreach (var l in lines)
                                                outStream.WriteLine(l);
                                            first = false;
                                        }
                                        else
                                        {
                                            // skip header
                                            for (int i = 1; i < lines.Length; i++)
                                                outStream.WriteLine(lines[i]);
                                        }
                                    }
                                }

                                // cleanup temp files
                                foreach (var tf in tempFiles)
                                {
                                    try { System.IO.File.Delete(tf); } catch { }
                                }
                            }
                            catch (Exception ex)
                            {
                                gLog.Error(ex.ToString());
                            }
                        }
                        else
                        {
                            // Structural: produce per-instance outputs and concatenate
                            List<string> outputs = new List<string>();
                            foreach (var g in groups)
                            {
                                var tmpl = g.Key;
                                _currentTemplate = tmpl;

                                var localProfile = tmpl.Profiles.Items.Where(p => p.Name == profile.Name && p.ExportType == profile.ExportType && p.FormatType == profile.FormatType && p.CustomFormat == profile.CustomFormat && p.TabularExportDelimiter == profile.TabularExportDelimiter).SingleOrDefault();
                                if (localProfile == null)
                                {
                                    MessageBox.Show("Profile not found on template " + tmpl.Name);
                                    return;
                                }

                                foreach (var inst in g)
                                {
                                    string temp = System.IO.Path.GetTempFileName();
                                    pac.ExportStructuralProfile(localProfile, inst, temp);
                                    outputs.Add(System.IO.File.ReadAllText(temp));
                                    try { System.IO.File.Delete(temp); } catch { }
                                }
                            }

                            System.IO.File.WriteAllText(saveFileDialog.FileName, string.Join(Environment.NewLine, outputs));
                        }
                    }
                    finally
                    {
                        // restore original template
                        _currentTemplate = originalTemplate;
                    }

                    return;
                }

                // single instance or template-level export
                if (profile.ExportType == ProfileExportTypes.Tabular)
                    pac.ExportTabularProfile(profile, selectedInstance, saveFileDialog.FileName);
                else
                    pac.ExportStructuralProfile(profile, selectedInstance, saveFileDialog.FileName);
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private void ImportProfile(StreamReader reader, Template template)
        {
            try
            {
                //import profiles
                string line = reader.ReadLine();
                if (line == null)
                    return;

                string[] items = line.Split(new char[] { ':' }, StringSplitOptions.RemoveEmptyEntries);
                if (items.Length != 2 || items[0].Equals("Name", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nUnknown file format");
                    return;
                }

                Profile profile = new Profile() { Name = items[1].Trim().Equals("NULL", StringComparison.OrdinalIgnoreCase) ? string.Empty : items[1].Trim() };

                //read description
                line = reader.ReadLine();
                items = line.Split(new char[] { ':' }, StringSplitOptions.RemoveEmptyEntries);
                if (items.Length != 2 || items[0].Equals("Description", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nUnknown file format");
                    return;
                }

                profile.Description = items[1].Trim().Equals("NULL", StringComparison.OrdinalIgnoreCase) ? string.Empty : items[1].Trim();

                //read export settings
                line = reader.ReadLine();
                items = line.Split(new char[] { ':' }, StringSplitOptions.RemoveEmptyEntries);
                if (items.Length != 2 || items[0].Equals("Export", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nUnknown file format");
                    return;
                }

                items = items[1].Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                if (items.Length < 3)
                {
                    MainWindow.ShowMessage("Template import failed\r\nUnknown file format");
                    return;
                }

                profile.ExportType = Convert.ToInt32(items[0].Trim());
                profile.FormatType = Convert.ToInt32(items[1].Trim());
                profile.CustomFormat = items[2].Trim().Equals("NULL", StringComparison.OrdinalIgnoreCase) ? string.Empty : items[2].Trim();
                profile.TabularExportDelimiter = items.Length < 4 ? "," : items[3].Trim().Equals("NULL", StringComparison.OrdinalIgnoreCase) ? string.Empty : items[3].Trim();

                //read structural export template 
                line = reader.ReadLine();
                if (line.Equals("BEGIN STRUCTURAL EXPORT TEMPLATE", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nUnknown file format");
                    return;
                }

                StringBuilder structuralTemplate = new StringBuilder();
                while ((line = reader.ReadLine()) != null && line.Equals("END STRUCTURAL EXPORT TEMPLATE", StringComparison.OrdinalIgnoreCase) == false)
                    structuralTemplate.Append(line).Append(Environment.NewLine);

                profile.StructuralExportTemplate = structuralTemplate.ToString();

                //read attributes header
                line = reader.ReadLine();
                items = line.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

                //check attribute names
                if (items[0].Equals("Name", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nImported template's attributes do not match pattern");
                    return;
                }

                if (items[1].Equals("Description", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nImported template's attributes do not match pattern");
                    return;
                }

                if (items[2].Equals("DataType", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nImported template's attributes do not match pattern");
                    return;
                }

                if (items[3].Equals("Rule", StringComparison.OrdinalIgnoreCase) == false)
                {
                    MainWindow.ShowMessage("Template import failed\r\nImported template's attributes do not match pattern");
                    return;
                }

                //create profile attributes
                while ((line = reader.ReadLine()) != null && line.Equals("Type: Profile", StringComparison.OrdinalIgnoreCase) == false)
                {
                    string[] values = line.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

                    if (values.Length < items.Length)
                    {
                        MainWindow.ShowMessage("Template import failed\r\nImported template's attributes do not match pattern");
                        return;
                    }

                    ProfileAttribute attribute = new ProfileAttribute();

                    //name
                    int startIndex = line.IndexOf(',');
                    attribute.Id = profile.Attributes.GetNextId();
                    attribute.Name = line.Substring(0, startIndex++);

                    //description
                    int stopIndex = line.IndexOf(',', startIndex);
                    attribute.Description = line.Substring(startIndex, stopIndex - startIndex);

                    //data type
                    startIndex = ++stopIndex;
                    stopIndex = line.IndexOf(',', startIndex);
                    int dataType = DataTypes.Parse(line.Substring(startIndex, stopIndex - startIndex));
                    if (dataType == -1)
                    {
                        MainWindow.ShowMessage("Template import failed\r\nUknown data type {0}", line.Substring(startIndex, stopIndex - startIndex));
                        return;
                    }

                    attribute.DataType = dataType;

                    //rule
                    startIndex = ++stopIndex;
                    attribute.Rule = line.Substring(startIndex, line.Length - startIndex);

                    profile.Attributes.Items.Add(attribute);
                }

                template.AddProfile(profile);

                //import another profile
                if (line != null && line.Equals("Type: Profile", StringComparison.OrdinalIgnoreCase))
                    ImportProfile(reader, template);
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

