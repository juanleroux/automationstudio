        private void ImportInstance(StreamReader reader, Template template)
        {
            try
            {
                //read name
                string line = reader.ReadLine();
                string[] items = line.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                int[] ids = new int[items.Length];

                //check attributes count
                if ((items.Length - 2) != template.Attributes.Items.Count)
                {
                    MainWindow.ShowMessage("Instance import failed\r\nImported instance's attributes do not match template's attributes");
                    return;
                }

                //check attribute names, get id's from template
                // 0 is name, 1 description, attributes start from index 2
                for (int i = 2; i < items.Length; i++)
                {
                    var attribute = template.Attributes.Items.Where(u => u.Name.Equals(items[i], StringComparison.OrdinalIgnoreCase)).FirstOrDefault();
                    if (attribute == null)
                    {
                        MainWindow.ShowMessage("Instance import failed\r\nImported instance's attributes do not match template's attributes");
                        return;
                    }
                    else
                        ids[i] = attribute.Id;
                }

                //create instances
                while ((line = reader.ReadLine()) != null)
                {
                    //add to template
                    Instance instance = new Instance(ids, line);
                    template.AddInstance(instance);

                    //add to unassigned area
                    _project.Areas.Items.Where(u => u.Id == 0).Single().AddInstance(instance);
                }

                template.IsExpanded = true;
                _treeView.UpdateLayout();
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

