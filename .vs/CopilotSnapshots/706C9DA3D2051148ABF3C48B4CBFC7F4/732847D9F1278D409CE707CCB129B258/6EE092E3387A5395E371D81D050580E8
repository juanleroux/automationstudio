<UserControl 
    x:Name="ViewControl"
    x:Class="TagCreator.ModelViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:a="clr-namespace:TagCreator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    d:DesignHeight="400" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="300"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
        </Grid.ColumnDefinitions>
        <!--TreeView-->
        <Rectangle  Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Fill="#FFF5FAF7"/>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Grid>
                <TextBox x:Name="_searchTextBox" Style="{StaticResource HintTextBoxStyle}" Text="{Binding Path=SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsProjectLoaded}" Margin="10,10,7,0" FontSize="14" BorderBrush="#FFC8C8C8" KeyDown="_searchTextBox_KeyDown" Padding="0,0,22,0" />
                <Image Source="/Images/Magnifier.png" Height="25" HorizontalAlignment="Right" Margin="0,10,8,0" />
            </Grid>
            <Grid>
                <TextBlock Text="{Binding ProjectName, FallbackValue='ProjectName'}" Margin="12,10,0,5"  FontSize="16" FontWeight="Bold"/>
                <ComboBox x:Name="_treeViewComboBox" Style="{StaticResource TransparentComboBox}" HorizontalAlignment="Right" Margin="0,10,7,5" SelectedIndex="0" IsEnabled="{Binding IsProjectLoaded}" SelectionChanged="_treeViewComboBox_SelectionChanged" >
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Flagged"/>
                </ComboBox>
            </Grid>
        </StackPanel>
        <TreeView x:Name="_treeView" Grid.Column="0" Grid.Row="1" Margin="5,0,5,5" Background="#FFF5FAF7" a:DragDropScrollExtension.ScrollOnDragDrop="True" SelectedItemChanged="_treeView_SelectedItemChanged" PreviewMouseRightButtonDown="_treeView_PreviewMouseRightButtonDown" BorderThickness="0" AllowDrop="True" PreviewMouseLeftButtonDown="_treeView_PreviewMouseLeftButtonDown" PreviewMouseMove="_treeView_PreviewMouseMove" DragEnter="_treeView_DragEnter" DragOver="_treeView_DragOver" Drop="_treeView_Drop" PreviewMouseLeftButtonUp="_treeView_PreviewMouseLeftButtonUp" BorderBrush="#FF828790">
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFAEC9EA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                <Style TargetType="{x:Type TreeViewItem}">
					<!-- <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/> -->
					<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/> <!--  , UpdateSourceTrigger=PropertyChanged}"/> -->
					<Style.Triggers>

						<!-- Custom multi selection -->
						<DataTrigger Binding="{Binding IsSelected}" Value="True">
							<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
							<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
						</DataTrigger>

						<DataTrigger Binding="{Binding IsFlaggedHidden}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>                    
                </Style>
                <HierarchicalDataTemplate DataType="{x:Type a:Area}" ItemsSource="{Binding Instances.Items, Converter={StaticResource TreeViewConverter}, ConverterParameter=Id}">
					<Grid x:Name="rootGrid" Background="Transparent">
                        <Image Width="16" Height="16" Source="/Images/Template.png" HorizontalAlignment="Left" />
                        <TextBlock x:Name="nameTextBlock" Text="{Binding Name}" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBox x:Name="editNameTextBox" Margin="20,0,0,0" Visibility="Hidden" MinWidth="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" IsVisibleChanged="editNameTextBox_IsVisibleChanged" KeyDown="editNameTextBox_KeyDown" LostFocus="editNameTextBox_LostFocus"/>
                    </Grid>
                    <HierarchicalDataTemplate.Triggers>
                        <MultiDataTrigger>
                            <!-- Selected, editing is generally active - the text box is displayed -->
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}" Value="True"/>
                                <Condition Binding="{Binding IsTreeViewEditMode, ElementName=ViewControl}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="editNameTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="editNameTextBox" Property="MinWidth" Value="100" />
                        </MultiDataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type a:Instance}">
					<Grid x:Name="rootGrid" Background="Transparent">
                        <Image x:Name="iconImage" Width="16" Height="16" Source="/Images/Instance.png" HorizontalAlignment="Left" />
						<TextBlock x:Name="nameTextBlock"  Text="{Binding Name}" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBox x:Name="editNameTextBox" Margin="20,0,0,0" Visibility="Hidden" MinWidth="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" IsVisibleChanged="editNameTextBox_IsVisibleChanged" KeyDown="editNameTextBox_KeyDown" LostFocus="editNameTextBox_LostFocus" />
                    </Grid>
                    <DataTemplate.Triggers>

						<DataTrigger Binding="{Binding IsSelected}" Value="True">
							<Setter TargetName="nameTextBlock" Property="Foreground" Value="White"/>
						</DataTrigger>

						<DataTrigger  Binding="{Binding IsFlagged}" Value="True">
                            <Setter TargetName="iconImage" Property="Source" Value="/Images/Instance_Red.png" />
                            <Setter TargetName="nameTextBlock" Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <!-- Selected, editing is generally active - the text box is displayed -->
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}" Value="True"/>
                                <Condition Binding="{Binding IsTreeViewEditMode, ElementName=ViewControl}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="editNameTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="editNameTextBox" Property="MinWidth" Value="100" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </TreeView.Resources>
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add area" IsEnabled="{Binding IsProjectLoaded}" Click="AddAreaMenuItem_Click" /> 
                    <Separator/>
                    <MenuItem Header="Duplicate" IsEnabled="{Binding IsUserAreaSelected}" Click="DuplicateMenuItem_Click"/>
                    <MenuItem Header="Delete" IsEnabled="{Binding IsUserAreaOrInstanceSelected}" Click="DeleteMenuItem_Click"/>
                    <MenuItem Header="Rename" IsEnabled="{Binding IsUserAreaOrInstanceSelected}" Click="RenameMenuItem_Click"/>
                    <Separator>
                        <Separator.Style>
                            <Style TargetType="{x:Type Separator}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstanceSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                        </Separator>
                        <MenuItem Click="SetFlagMenuItem_Click">
                        <MenuItem.Style>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Header" Value="Set flag"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger  Binding="{Binding IsInstanceFlagged}" Value="True">
                                        <Setter Property="Header" Value="Reset flag" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInstanceSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>                                       
                    <MenuItem x:Name="_treeViewExportProfileMenuItem" Header="Export" >
                        <MenuItem.Style>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Show export menu when an instance OR an area is selected -->
                                    <DataTrigger Binding="{Binding IsInstanceSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAreaSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- also allow when a user area (non-Unassigned) is selected -->
                                    <DataTrigger Binding="{Binding IsUserAreaSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- also allow when project has any instances (needed for Export All / Ignition uploads) -->
                                    <DataTrigger Binding="{Binding HasAnyInstances}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                        <MenuItem Header="Instance" IsEnabled="{Binding HasTemplateAttributes}" Click="ExportInstanceMenuItem_Click"/>                        
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <Separator Grid.Row="1" VerticalAlignment="Bottom" Margin="5,0,5,0" Background="#FFCDCDCD"/>
        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button  Width="50" Style="{DynamicResource GrayIconButtonStyle}" Content="/Images/SharedFolder.png" ToolTip="Folder" IsEnabled="{Binding IsFolderSet}" Click="OpenFolderButton_Click"/>
            <Button  Width="50" Style="{DynamicResource GrayIconButtonStyle}" Content="/Images/Derivation.png" ToolTip="Derivation" IsEnabled="{Binding IsProjectLoaded}" Click="DerivationButton_Click" />
            <Button  Width="50" Style="{DynamicResource GrayIconButtonStyle}" Content="/Images/HierarchicalStructure.png" ToolTip="Model" IsEnabled="{Binding IsProjectLoaded}" Click="ModelViewButton_Click"/>
            <Button  Width="50" Style="{DynamicResource GrayIconButtonStyle}" Content="/Images/Elipses.png" IsEnabled="false"/>
        </StackPanel>    
        <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="#FFF5FAF7"/>
        <!--Details-->
        <TabControl x:Name="_tabControl" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" SelectedIndex="0" Margin="0,0,0,1" SelectionChanged="TabControl_SelectionChanged" PreviewMouseRightButtonDown="_tabControl_PreviewMouseRightButtonDown" BorderThickness="0" Background="White" >
            <TabItem Visibility="Collapsed">
                <a:AreaControl x:Name="_areaControl" Margin="-4,-4,-4,-4" />
            </TabItem>
            <TabItem Visibility="Collapsed">
                <a:TemplateAttributesControl x:Name="_templateAttributesControl" Margin="-4,-4,-4,-4" />
            </TabItem>
        </TabControl>
        <!--Bottom buttons panel-->
        <Separator Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="5,0,5,0" Background="{DynamicResource ThemeMainBrush}"/>
        <Button Grid.Column="2" Grid.Row="2" Width="50" Style="{DynamicResource ThemeIconButtonStyle}" Content="/Images/ListWithDots.png" IsEnabled="{Binding IsInstanceSelected}" HorizontalAlignment="Left" Click="ViewAttributesButton_Click"/>
        <StackPanel x:Name="_profilesNavigationPanel" Grid.Column="2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="50" Style="{DynamicResource ThemeIconButtonStyle}" Content="/Images/Elipses.png" IsEnabled="{Binding IsInstanceSelected}" Click="ProfileContextMenuButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
