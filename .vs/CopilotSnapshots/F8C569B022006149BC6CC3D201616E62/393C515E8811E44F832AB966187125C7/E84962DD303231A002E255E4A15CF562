        private void AddProfileTabPage(Profile profile)
        {
            //add navigation button
            Button button = new Button();
            button.Width = 50;
            button.Style = (Style)FindResource("ThemeIconButtonStyle");
            button.Content = profile.ExportType == ProfileExportTypes.Tabular ? "/Images/Grid.png" : "/Images/HtmlCoding.png";
            button.ToolTip = profile.Name;
            button.Tag = profile;
            button.Click += ViewProfileButton_Click;

            _profilesNavigationPanel.Children.Insert(_profilesNavigationPanel.Children.Count - 1, button);

            //add tab page            
            TabItem tabItem = new TabItem() { Tag = profile };
            tabItem.Content = new ProfileAttributesControl() { ParentProxy = _parentProxy, MainWindow = MainWindow, Profile = profile, Margin = new Thickness(-4, -4, -4, -4), Project = _project };
            tabItem.Visibility = System.Windows.Visibility.Collapsed;

            _tabControl.Items.Add(tabItem);

            //add export profile menu items      
            MenuItem menuItem = new MenuItem() { Header = profile.Name, Tag = profile };
            menuItem.Click += ExportProfileMenuItem_Click;
            _treeViewExportProfileMenuItem.Items.Add(menuItem);
        }

