        public void DeleteProfile(Profile profile)
        {
            if (MainWindow.Confirm("Are you sure that you want to delete profile {0}?", profile.Name) != true)
                return;

            try
            {
                //remove profile and tab page
                _currentTemplate.RemoveProfile(profile);
                var tabItem = _tabControl.Items.Cast<TabItem>().Where(u => u.Tag == profile).Single();
                _tabControl.Items.Remove(tabItem);

                //show attributes tab page
                _tabControl.SelectedIndex = 0;

                //remove Export profile menu items
                var treeViewItem = _treeViewExportProfileMenuItem.Items.Cast<Control>().Where(u => u.Tag == profile).Single();
                _treeViewExportProfileMenuItem.Items.Remove(treeViewItem);

                //remove separator
                if (_currentTemplate.Profiles.Items.Count == 0)
                {
                    treeViewItem = _treeViewExportProfileMenuItem.Items.Cast<Control>().Where(u => u.GetType() == typeof(Separator)).FirstOrDefault();
                    _treeViewExportProfileMenuItem.Items.Remove(treeViewItem);
                }

                //remove navigation button
                Button button = _profilesNavigationPanel.Children.Cast<Button>().Where(u => u.Tag == profile).Single();
                _profilesNavigationPanel.Children.Remove(button);

                NotifyPropertyChanged("TemplateLastModification");
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private bool IsMouseOverScrollbar(object sender, Point position)
        {
            if ((sender is Visual) == false)
                return false;

            HitTestResult result = VisualTreeHelper.HitTest(sender as Visual, position);
            if (result == null)
                return false;

            DependencyObject obj = result.VisualHit;
            while (obj != null)
            {
                if (obj is Microsoft.Windows.Themes.ScrollChrome)
                    return true;

                if (obj is Visual)
                    obj = VisualTreeHelper.GetParent(obj);
            }

            return false;
        }

