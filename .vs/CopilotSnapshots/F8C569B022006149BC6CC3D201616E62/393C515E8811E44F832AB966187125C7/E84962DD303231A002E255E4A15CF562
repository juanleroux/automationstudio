        private void _treeView_PreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)
        {
            //set long press renamed item
            _renameTreeViewItem = GetNearestTreeViewItem(e.OriginalSource as UIElement);
            if (_renameTreeViewItem == null)
                return;

            _treeViewTimer.Start();
            _dragDropStartPosition = e.GetPosition(null);

            // MULTI SELECT (Model view ordering: Areas then Instances)
            try
            {
                DependencyObject obj = (DependencyObject)e.OriginalSource;
                while (obj != null && !(obj is TreeViewItem))
                    obj = VisualTreeHelper.GetParent(obj);

                if (obj == null)
                    return;

                TreeViewItem clickedItem = obj as TreeViewItem;
                clickedItem.Focus();

                var item = clickedItem.DataContext;

                bool isCtrl = Keyboard.IsKeyDown(Key.LeftCtrl) || Keyboard.IsKeyDown(Key.RightCtrl);
                bool isShift = Keyboard.IsKeyDown(Key.LeftShift) || Keyboard.IsKeyDown(Key.RightShift);

                // ------------------ INSTANCE ------------------
                if (item is Instance instance)
                {
                    _lastSelectedArea = null;

                    if (isCtrl)
                    {
                        instance.IsSelected = !instance.IsSelected;

                        if (instance.IsSelected)
                            _selectedInstances.Add(instance);
                        else
                            _selectedInstances.Remove(instance);

                        _lastSelectedInstance = instance;

                        foreach (var a in _project.Areas.Items)
                            a.IsSelected = false;

                        e.Handled = true;
                    }
                    else if (isShift && _lastSelectedInstance != null)
                    {
                        var allInstances = GetAllInstances();

                        int start = allInstances.IndexOf(_lastSelectedInstance);
                        int end = allInstances.IndexOf(instance);

                        if (start > end)
                        {
                            int temp = start;
                            start = end;
                            end = temp;
                        }

                        foreach (var inst in allInstances.Skip(start).Take(end - start + 1))
                        {
                            inst.IsSelected = true;
                            if (!_selectedInstances.Contains(inst))
                                _selectedInstances.Add(inst);
                        }
                    }
                    else
                    {
                        ClearAllSelections();

                        instance.IsSelected = true;
                        _selectedInstances.Add(instance);
                        _lastSelectedInstance = instance;
                    }
                }

                // ------------------ AREA ------------------
                else if (item is Area area)
                {
                    _lastSelectedArea = area;
                    _lastSelectedInstance = null;

                    // Clear ALL selections (instances + areas)
                    ClearAllSelections();

                    foreach (var a in _project.Areas.Items)
                        a.IsSelected = false;

                    area.IsSelected = true;
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private void DuplicateMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;

            try
            {
                if (selectedItem == null)
                    return;

                //get selected template
                if (selectedItem.GetType() == typeof(Template))
                {
                    var template = _project.Templates.Items.Where(u => u == (Template)selectedItem).Single();
                    var newTemplate = new Template(template as Template);

                    //find number at end of name
                    Match m = Regex.Match(template.Name, @"\d+$");
                    if (m.Success)
                    {
                        int num = Convert.ToInt32(m.Value);

                        //increment number, search for unique name in template's list
                        do
                        {
                            //add leading zeroes
                            string sNum = (++num).ToString();
                            while (m.Value.Length > sNum.Length)
                                sNum = sNum.Insert(0, "0");

                            newTemplate.Name = string.Format("{0}{1}", template.Name.Substring(0, template.Name.Length - m.Value.Length), sNum);
                        }
                        while (_project.Templates.Items.Count(u => u.Name.Equals(newTemplate.Name, StringComparison.OrdinalIgnoreCase)) > 0);
                    }

                    _project.Templates.AddTemplate(newTemplate);

                    //select treeView item and put in edit mode
                    newTemplate.IsSelected = true;
                    IsTreeViewEditMode = true;
                }

                //get selected instance
                if (selectedItem.GetType() == typeof(Instance))
                {
                    var template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                    var instance = template.Instances.Items.Where(u => u == (Instance)selectedItem).Single();
                    var newInstance = new Instance(instance as Instance);

                    //find number at end of name
                    Match m = Regex.Match(instance.Name, @"\d+$");
                    if (m.Success)
                    {
                        int num = Convert.ToInt32(m.Value);

                        //increment number, search for unique name in instances list
                        do
                        {
                            //add leading zeroes
                            string sNum = (++num).ToString();
                            while (m.Value.Length > sNum.Length)
                                sNum = sNum.Insert(0, "0");

                            newInstance.Name = string.Format("{0}{1}", instance.Name.Substring(0, instance.Name.Length - m.Value.Length), sNum);
                        }
                        while (template.Instances.Items.Count(u => u.Name.Equals(newInstance.Name, StringComparison.OrdinalIgnoreCase)) > 0);
                    }

                    //add to template
                    template.AddInstance(newInstance);

                    //add to area
                    _project.Areas.Items.Where(u => u.Id == newInstance.AreaId).Single().AddInstance(newInstance);

                    //select treeView item and put in edit mode
                    template.IsExpanded = true;
                    newInstance.IsSelected = true;

                    _treeView.UpdateLayout();
                    IsTreeViewEditMode = true;
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private void DeleteMenuItem_Click(object sender, RoutedEventArgs e)
        {
            var selectedItem = _treeView.SelectedItem;

            try
            {
                if (selectedItem == null)
                    return;

                //get selected area
                if (selectedItem.GetType() == typeof(Area))
                {
                    var area = _project.Areas.Items.Where(u => u == (Area)selectedItem).Single();

                    if (MainWindow.Confirm("Are you sure that you want to delete area {0}?", area.Name) == true)
                    {
                        foreach (Instance instance in area.Instances.Items)
                        {
                            instance.AreaId = 0;
                            _project.Areas.Items.Where(u => u.Id == 0).Single().AddInstance(instance);
                        }

                        _project.Areas.Items.Remove(area);
                    }

                    return;
                }

                //get selected instance
                if (selectedItem.GetType() == typeof(Instance))
                {
                    var template = _project.Templates.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)selectedItem) > 0).Single();
                    var instance = template.Instances.Items.Where(u => u == (Instance)selectedItem).Single();

                    if (MainWindow.Confirm("Are you sure that you want to delete instance {0}?", instance.Name) == true)
                    {
                        template.RemoveInstance(instance);
                        _project.Areas.Items.Where(u => u.Id == instance.AreaId).Single().RemoveInstance(instance);
                    }

                    return;
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

