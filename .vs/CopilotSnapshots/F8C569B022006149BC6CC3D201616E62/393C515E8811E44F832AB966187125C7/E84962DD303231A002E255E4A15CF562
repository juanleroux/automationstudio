                e.Handled = true;
            }
        }

        private void _treeView_Drop(object sender, DragEventArgs e)
        {
            try
            {
                //get TreeViewItem object
                TreeViewItem item = GetNearestTreeViewItem(e.OriginalSource as UIElement);
                if (item == null)
                    return;

                if (e.Data.GetDataPresent("Instance"))
                {
                    //get target Area
                    Area area = null;
                    if (item.DataContext.GetType() == typeof(Area))
                        area = (Area)item.DataContext;

                    if (item.DataContext.GetType() == typeof(Instance))
                        area = _project.Areas.Items.Where(u => u.Instances.Items.Count(x => x == (Instance)item.DataContext) > 0).SingleOrDefault();

                    //get dragged object
                    Instance movedInstance = e.Data.GetData("Instance") as Instance;
                    Area movedInstanceArea = _project.Areas.Items.Where(u => u.Instances.Items.Count(x => x == movedInstance) > 0).SingleOrDefault();

                    if (area == movedInstanceArea)
                        return;

                    //remove from old area
                    movedInstanceArea.RemoveInstance(movedInstance);                   

                    //add instance to area
                    area.AddInstance(movedInstance);
                    movedInstance.AreaId = area.Id;
                    
                    //select treeView item 
                    area.IsExpanded = true;
                    movedInstance.IsSelected = true;
                   
                    _treeView.UpdateLayout();

                    NotifyPropertyChanged("TemplateLastModification");
                    _parentProxy.NotifyPropertyChanged("TemplateLastModification");
                }
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }
        }

        private TreeViewItem GetNearestTreeViewItem(UIElement element)
        {
            try
            {
                TreeViewItem item = (element as UIElement) as TreeViewItem;
                while (item == null && element != null)
                {
                    element = VisualTreeHelper.GetParent(element) as UIElement;
                    item = element as TreeViewItem;
                }

                return item;
            }
            catch (Exception ex)
            {
                gLog.Error(ex.ToString());
            }

            return null;
        }        

