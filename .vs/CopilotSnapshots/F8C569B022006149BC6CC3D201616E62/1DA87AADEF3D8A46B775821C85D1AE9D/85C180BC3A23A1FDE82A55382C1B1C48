		// Gateway Connection Check
		public async void CheckGatewayConnection_Click(string gatewayUrl)
		{
			try
			{
				using (HttpClient client = new HttpClient())
				{
					client.Timeout = TimeSpan.FromSeconds(5);

					HttpResponseMessage response = await client.GetAsync(gatewayUrl);

					if (response.IsSuccessStatusCode)
					{
						MessageBox.Show("Connection successful!");
					}
					else
					{
						MessageBox.Show($"Connection failed: {response.StatusCode}");
					}
				}
			}
			catch (Exception ex)
			{
				MessageBox.Show("Connection failed: " + ex.ToString());
			}
