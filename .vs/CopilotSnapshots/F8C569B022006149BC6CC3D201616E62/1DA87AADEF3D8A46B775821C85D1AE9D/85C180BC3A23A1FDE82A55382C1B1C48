        // Build parameters dictionary based on template parameter definitions (safe keys)
		private Dictionary<string, object> BuildParametersFromTemplate(Instance instance, Template template)
		{
			var dict = new Dictionary<string, object>();
			if (template?.Attributes?.Items == null)
				return dict;

			foreach (var tAttr in template.Attributes.Items.Where(t => t.Parameter))
			{
				string name = tAttr.Name;
				if (string.IsNullOrWhiteSpace(name))
					continue;

				var instAttr = instance?.Attributes?.Items?.FirstOrDefault(a => a.Id == tAttr.Id);
           // only include parameter if instance has an overriding attribute marked as parameter
			// and that attribute actually has a value (avoid sending empty overrides)
			if (instAttr == null || !instAttr.Parameter || string.IsNullOrWhiteSpace(instAttr.Value))
					continue;

				object value = ParseValue(instAttr.Value, tAttr.DataType);

				dict[name] = new
				{
					dataType = ToIgnitionType(tAttr.DataType),
					value = value
				};
			}

			return dict;
		}

		// Build atomic (non-parameter) tags based on template attribute names
		private List<object> BuildAtomicTagsFromTemplate(Instance instance, Template template)
		{
			var list = new List<object>();
			if (template?.Attributes?.Items == null)
				return list;

			foreach (var tAttr in template.Attributes.Items.Where(t => !t.Parameter))
			{
				string name = tAttr.Name;
				if (string.IsNullOrWhiteSpace(name))
					continue;

				var instAttr = instance?.Attributes?.Items?.FirstOrDefault(a => a.Id == tAttr.Id);
				object value = instAttr != null ? ParseValue(instAttr.Value, tAttr.DataType) : null;

				list.Add(new
				{
					name = name,
					value = value,
					tagType = "AtomicTag"
				});
			}

			return list;
		}

		public async Task UploadAllAreasAsFolders(string gatewayUrl, string apiKey, Project project)
		{
            try
			{
				if (string.IsNullOrWhiteSpace(gatewayUrl) || string.IsNullOrWhiteSpace(apiKey))
				{
					MessageBox.Show("Gateway URL and API Key are required to upload tags to Ignition.");
					return;
				}

				if (project?.Areas?.Items == null || !project.Areas.Items.Any())
				return;

			var folders = new List<object>();
			var rootInstances = new List<object>();

           foreach (var area in project.Areas.Items ?? Enumerable.Empty<Area>())
			{
              if (area?.Instances?.Items == null || !area.Instances.Items.Any())
					continue;

				// UNASSIGNED AREA → FLATTEN TO ROOT
             if (area.Name.Equals("Unassigned", StringComparison.OrdinalIgnoreCase))
				{
                  foreach (var instance in area.Instances.Items ?? Enumerable.Empty<Instance>())
					{
                      var template = project?.Templates?.Items?.FirstOrDefault(t => t.Instances?.Items?.Contains(instance) == true);

                        var parameters = BuildParametersFromTemplate(instance, template);
						var atomicTags = BuildAtomicTagsFromTemplate(instance, template);

                        rootInstances.Add(new
						{
							name = instance.Name,
							tagType = "UdtInstance",
							typeId = template?.Name,
							parameters = parameters != null && parameters.Count > 0 ? parameters : null,
							tags = atomicTags
						});
					}

					continue;
				}

				// NORMAL AREA → FOLDER
                var folder = new
				{
					name = area.Name,
					tagType = "Folder",
                 tags = (area.Instances?.Items ?? Enumerable.Empty<Instance>()).Select(instance =>
					{
                        var template = project?.Templates?.Items?.FirstOrDefault(t => t.Instances?.Items?.Contains(instance) == true);

						var attrs = (instance.Attributes?.Items ?? Enumerable.Empty<InstanceAttribute>());

                        // build instance payload using template-driven helpers
						var parameters = BuildParametersFromTemplate(instance, template);
						var atomicTags = BuildAtomicTagsFromTemplate(instance, template);

						return new
						{
							name = instance.Name,
							tagType = "UdtInstance",
							typeId = template?.Name,
                        parameters = (parameters != null && parameters.Count > 0) ? parameters : null,
							tags = atomicTags
						};
					}).ToList()
				};

				folders.Add(folder);
			}

			// FINAL PAYLOAD = folders + root-level instances
			var allTags = new List<object>();
			allTags.AddRange(folders);
			allTags.AddRange(rootInstances);

			var body = new { tags = allTags };
			string jsonBody = JsonConvert.SerializeObject(body);

         await UploadTagsJson(gatewayUrl, apiKey, jsonBody);
			}
			catch (Exception ex)
			{
				MessageBox.Show($"Error uploading all areas to Ignition:\n{ex.Message}", "Upload Error", MessageBoxButton.OK, MessageBoxImage.Error);
			}
		}

		public async Task UploadAreaAsFolder(string gatewayUrl, string apiKey, Project project, Area area)
		{
         try
			{
				if (string.IsNullOrWhiteSpace(gatewayUrl) || string.IsNullOrWhiteSpace(apiKey))
				{
					MessageBox.Show("Gateway URL and API Key are required to upload tags to Ignition.");
					return;
				}

				if (area == null ||
					string.IsNullOrWhiteSpace(area.Name) ||
					area.Name.Equals("Unassigned", StringComparison.OrdinalIgnoreCase) ||
					area.Instances?.Items == null ||
					!area.Instances.Items.Any())
				{
					MessageBox.Show("Cannot upload Unassigned area. Please select a different area.");
					return;
				}

				MessageBox.Show($"Area Name: '{area.Name}'");

			var folderTag = new
			{
				name = area.Name,
				tagType = "Folder",
              tags = (area.Instances?.Items ?? Enumerable.Empty<Instance>()).Select(instance =>
				{
					var template = project?.Templates?.Items?.FirstOrDefault(t => t.Instances?.Items?.Contains(instance) == true);

					// use template-driven helpers to build parameter map and atomic tags (safe keys)
					var parameters = BuildParametersFromTemplate(instance, template);
					var tagsList = BuildAtomicTagsFromTemplate(instance, template);

					return new
					{
						name = instance.Name,
						tagType = "UdtInstance",
						typeId = template?.Name,

						parameters = parameters,
						tags = tagsList
					};
				}).ToList()
			};

			var body = new { tags = new[] { folderTag } };
			string jsonBody = JsonConvert.SerializeObject(body);
			await UploadTagsJson(gatewayUrl, apiKey, jsonBody);
			}
			catch (Exception ex)
			{
				MessageBox.Show($"Error uploading area to Ignition:\n{ex.Message}", "Upload Error", MessageBoxButton.OK, MessageBoxImage.Error);
			}
		}

		public async Task UploadTagsJson(string gatewayUrl, string apiKey, string jsonBody)
		{
            try
			{
				if (string.IsNullOrWhiteSpace(gatewayUrl) || string.IsNullOrWhiteSpace(apiKey))
				{
					MessageBox.Show("Gateway URL and API Key are required to upload tags to Ignition.");
					return;
				}

				string endpoint = gatewayUrl.TrimEnd('/') + "/data/api/v1/tags/import?provider=default&type=json&collisionPolicy=Overwrite";

				using (HttpClient client = new HttpClient())
				{
					client.DefaultRequestHeaders.Add("X-Ignition-API-Token", apiKey);
					HttpContent content = new StringContent(jsonBody, Encoding.UTF8, "application/json");
					HttpResponseMessage response = await client.PostAsync(endpoint, content);

					string responseText = await response.Content.ReadAsStringAsync();
					dynamic jsonResponse = JsonConvert.DeserializeObject(responseText);

					if (jsonResponse.failureCount != null && jsonResponse.failureCount > 0)
					{
						List<string> failureMessages = new List<string>();
						foreach (var failure in jsonResponse.failures)
							failureMessages.Add((string)failure.diagnosticMessage);

						MessageBox.Show($"Failed to upload area:\n" + string.Join("\n", failureMessages));
					}
					else if (!response.IsSuccessStatusCode)
					{
						MessageBox.Show($"Failed to upload area: {response.StatusCode}\n{responseText}");
					}
				}
			}
			catch (Exception ex)
			{
				MessageBox.Show($"Error uploading tags to Ignition:\n{ex.Message}", "Upload Error", MessageBoxButton.OK, MessageBoxImage.Error);
			}
		}

		public async Task ImportUDTs(Project project)
		{
			string gatewayUrl = project.Engineering.IgnitionGateway;
			string apiKey = project.Engineering.APIKey;

			string endpoint = $"{gatewayUrl}/data/api/v1/tags/export?provider=default&path=_types_&type=json";

			try
			{
				using (HttpClient client = new HttpClient())
				{
					client.DefaultRequestHeaders.Add("X-Ignition-API-Token", apiKey);

					HttpResponseMessage response = await client.GetAsync(endpoint);
					string responseText = await response.Content.ReadAsStringAsync();

					if (!response.IsSuccessStatusCode)
					{
						MessageBox.Show($"Failed to export UDTs.\n{response.StatusCode}\n{responseText}");
						return;
					}

					dynamic json = JsonConvert.DeserializeObject(responseText);

					int templateCount = 0;
					int updatedTemplateCount = 0;
					int attributeCount = 0;

					// Find _types_ folder
					var typesFolder = json.tags;

					if (typesFolder == null)
					{
						MessageBox.Show("No UDT definitions found in Ignition.");
						return;
					}

					var udtNames = ((IEnumerable<dynamic>)typesFolder)
						.Where(udt => (string)udt.tagType == "UdtType")
						.Select(udt => (string)udt.name)
						.ToList();

					if (!udtNames.Any())
					{
						MessageBox.Show("No UDT definitions found in Ignition.");
						return;
					}

					// Show selection window
					SelectUDTsWindow selectWindow = new SelectUDTsWindow(udtNames)
					{
						Owner = Application.Current.MainWindow
					};

					bool? dialogResult = selectWindow.ShowDialog();
					if (dialogResult != true)
					{
						return; // User cancelled
					}

					var selectedUDTs = selectWindow.GetSelectedUDTs();
					if (!selectedUDTs.Any())
					{
						MessageBox.Show("No UDTs selected for import.");
						return;
					}

					foreach (var udt in typesFolder)
					{
						if ((string)udt.tagType != "UdtType")
							continue;

						string templateName = (string)udt.name;

						// Check if template already exists
						Template template = project.Templates.Items
							.FirstOrDefault(t => t.Name == templateName);

						bool isNewTemplate = template == null;

						if (isNewTemplate)
						{
							template = new Template();
							template.Name = templateName;
							project.Templates.Items.Add(template);
							templateCount++;
						}

						int nextId = template.Attributes.Items.Any() ? template.Attributes.Items.Max(a => a.Id) + 1 : 1;

						// Import normal tags (attributes)
						if (udt.tags != null)
						{
							foreach (var member in udt.tags)
							{
								if ((string)member.tagType != "AtomicTag")
									continue;

								string attributeName = member.name;
								string ignitionType = member.dataType != null ? member.dataType.ToString() : "Int4"; // Use "Int4" if dataType is missing to match ignitions default
								int dataTypeIndex = DataTypes.Parse(ignitionType);

								// Check if attribute already exists
								var existingAttribute = template.Attributes.Items.FirstOrDefault(a => a.Name == attributeName && !a.Parameter);
								if (existingAttribute != null)
								{
									// Update datatype or other properties if needed
									existingAttribute.DataType = dataTypeIndex;
								}
								else
								{
									var newAttribute = new TemplateAttribute
									{
										Id = nextId++,
										Name = attributeName,
										DataType = dataTypeIndex,
										Parameter = false
									};

									template.AddAttribute(newAttribute);
								}
								attributeCount++; // may need to move this inside the else block if you only want to count new attributes
							}
						}

						// Import parameters as attributes
						if (udt.parameters != null)
						{
							foreach (JProperty param in udt.parameters)
							{
								string paramName = param.Name;
								var paramObj = (JObject)param.Value;

								string ignitionType = paramObj["dataType"] != null ? (string)paramObj["dataType"] : "Int4";

								int dataTypeIndex = DataTypes.Parse(ignitionType);

								// Avoid duplicates if same name exists
								var existingParam = template.Attributes.Items.FirstOrDefault(a => a.Name == paramName && a.Parameter);
								if (existingParam != null)
								{
									// Update existing attribute
									existingParam.DataType = dataTypeIndex;
									existingParam.Parameter = true;
								}
								else
								{
									var paramAttribute = new TemplateAttribute
									{
										Id = nextId++,
										Name = paramName,
										DataType = dataTypeIndex,
										Parameter = true // mark as parameter
									};
									template.AddAttribute(paramAttribute);
									attributeCount++;
								}
							}
						}

						if (!isNewTemplate)
							updatedTemplateCount++;
					}

					MessageBox.Show($"Imported {templateCount} new templates, updated {updatedTemplateCount} templates and {attributeCount} attributes from Ignition.");
				}
			}
			catch (Exception ex)
			{
				MessageBox.Show($"Error importing UDTs from Ignition:\n{ex.Message}");
			}
		}

		public async void UploadToIgnition(string gatewayUrl, string apiKey, Project project, Instance instance)
		{
			try
			{
				// Validate inputs
				if (string.IsNullOrEmpty(gatewayUrl) || string.IsNullOrEmpty(apiKey))
				{
					MessageBox.Show("Gateway URL and API Key are required.");
					return;
				}

				if (project == null)
				{
					MessageBox.Show("No project loaded. Open a project before uploading tags.");
					return;
				}

				if (instance == null)
				{
					MessageBox.Show("No instance selected for upload.");
					return;
				}

				// Build endpoint URL
				string endpoint = gatewayUrl.TrimEnd('/') + "/data/api/v1/tags/import?provider=default&type=json&collisionPolicy=Overwrite";

				var template = project.Templates.Items.FirstOrDefault(t => t.Instances.Items.Contains(instance));

			var udtInstance = new
			{
				name = instance.Name,
				tagType = "UdtInstance",
				typeId = template?.Name,
				parameters = BuildParametersFromTemplate(instance, template),
				tags = BuildAtomicTagsFromTemplate(instance, template)
			};

				// Wrap for Ignition import
				var body = new { tags = new[] { udtInstance } };
				string jsonBody = JsonConvert.SerializeObject(body);

				// Send POST request
				using (HttpClient client = new HttpClient())
				{
					client.DefaultRequestHeaders.Add("X-Ignition-API-Token", apiKey);
					HttpContent content = new StringContent(jsonBody, Encoding.UTF8, "application/json");
					HttpResponseMessage response = await client.PostAsync(endpoint, content);

					// trying to pick up when tag fails upload due their not being a UDT def with matching name
					string responseText = await response.Content.ReadAsStringAsync();
					dynamic jsonResponse = JsonConvert.DeserializeObject(responseText);

					if (jsonResponse.failureCount != null && jsonResponse.failureCount > 0)
					{
						List<string> failureMessages = new List<string>();

						foreach (var failure in jsonResponse.failures)
						{
							failureMessages.Add((string)failure.diagnosticMessage);
						}

						MessageBox.Show($"Failed to upload '{instance.Name}':\n" + string.Join("\n", failureMessages));
					}
					else if (response.IsSuccessStatusCode)
					{
						//MessageBox.Show($"Instance '{instance.Name}' uploaded successfully.");
						//MessageBox.Show($"Upload finished.\nSuccess: {jsonResponse.successCount}\nFailures: {jsonResponse.failureCount}");
					}
					else
					{
						MessageBox.Show($"Failed to upload '{instance.Name}': {response.StatusCode}\n{responseText}");
					}
				}
			}
			catch (Exception ex)
			{
				MessageBox.Show("Error uploading tag: " + ex.Message);
			}
		}

		private string ToIgnitionType(int dataTypeIndex)
		{
			// Convert your DataTypes index to Ignition type string
			switch (dataTypeIndex)
			{
				case DataTypes.Bool:
					return "Boolean";
				case DataTypes.Int_4:
				case DataTypes.Int_8:
				case DataTypes.Int_16:
				case DataTypes.Int_32:
				case DataTypes.UInt_8:
				case DataTypes.UInt_16:
				case DataTypes.UInt_32:
					return "Integer";
				case DataTypes.Float:
					return "Float";
				case DataTypes.String:
				default:
					return "String";
			}
		}

		private object ParseValue(string value, int dataTypeIndex)
		{
			// Convert the string value to the correct type for Ignition
			switch (dataTypeIndex)
			{
				case (int)DataTypes.Float:
					return double.TryParse(value, out double d) ? d : 0.0;
				case (int)DataTypes.Int_4:
					return int.TryParse(value, out int i) ? i : 0;
				case (int)DataTypes.Bool:
					return bool.TryParse(value, out bool b) ? b : false;
				default:
					return value; // treat as string
			}
		}


