<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.2.74</Version>
    <OutputType>Exe</OutputType>
    <!-- TIA Portal Openness ships as a .NET Framework 4.8 assembly, so the bridge
         must target net48 rather than .NET Core/5+ to load it in-process. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SiemensTiaBridge</RootNamespace>
    <AssemblyName>SiemensTiaBridge</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    Siemens.Engineering.dll (and Siemens.Engineering.Hmi.dll, etc.) are not distributed on
    NuGet. They ship with the TIA Portal installation. Copy the version matching your
    TiaVersion setting from the install, e.g.:
      C:\Program Files\Siemens\Automation\Portal V18\PublicAPI\V18\Siemens.Engineering.dll
    into the lib\ folder next to this .csproj (or update HintPath below to reference it
    directly from the Program Files location).
  -->
  <ItemGroup>
    <!--
      Siemens Openness DLLs are referenced from lib\ for compilation only.
      Private=false: Siemens DLLs must NOT be copied to bin\. V21+ Openness detects
      when assemblies are loaded from a local copy and throws FileLoadException with
      "Copy Local must be false". The bridge uses an AssemblyResolve handler in Main()
      to load them from registry-registered installation paths at runtime, which works
      for V19, V20, and V21+ without relying on the GAC.
    -->
    <_SiemensDlls Include="lib\*.dll" />
    <Reference Include="@(_SiemensDlls->'%(Filename)')">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
